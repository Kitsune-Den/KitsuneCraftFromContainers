<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>KitsuneCraftFromContainers</AssemblyName>
    <RootNamespace>KitsuneCraftFromContainers</RootNamespace>
    <Optimize>true</Optimize>
    <Platforms>x64</Platforms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <!-- Output the DLL into the deployable payload folder -->
    <OutputPath>KitsuneCraftFromContainers\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- 3.3 CLIENT install. The client assembly is the superset: the dedicated
         server build strips UI and hard-codes IsDedicatedServer. Override with
         -p:GameDir=... to build against another install. -->
    <GameDir Condition="'$(GameDir)' == ''">G:\SteamLibrary\steamapps\common\7 Days To Die</GameDir>
    <ManagedDir>$(GameDir)\7DaysToDie_Data\Managed</ManagedDir>
    <HarmonyDir>$(GameDir)\Mods\0_TFP_Harmony</HarmonyDir>
    <!-- Otherwise refs/*.dll become project items, and reference resolution
         checks those before HintPath, so they'd win over the real game. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);refs\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- No game install here (CI, or a contributor without the game): build
       against the stripped reference assemblies in refs/ instead. They hold
       the API only, no game code; tools/strip-refs.sh regenerates them. -->
  <PropertyGroup Condition="!Exists('$(ManagedDir)\Assembly-CSharp.dll')">
    <ManagedDir>$(MSBuildThisFileDirectory)refs</ManagedDir>
    <HarmonyDir>$(MSBuildThisFileDirectory)refs</HarmonyDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LogLibrary">
      <HintPath>$(ManagedDir)\LogLibrary.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
